{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Registration Configuration Schema",
  "description": "Schema for validating registration app configuration",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "searchExtensionParams": {
      "type": "object",
      "additionalProperties": false,
      "description": "Params for search-widget extensions",
      "properties": {
        "searchHandler": {
          "type": "string",
          "description": "Search widget key"
        },
        "configUrl": {
          "type": "string",
          "description": "Config URL for the search widget"
        }
      }
    },
    "actionExtensionParams": {
      "type": "object",
      "additionalProperties": false,
      "description": "Params for action-button extensions (link | startVisit)",
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": [
            "link",
            "startVisit"
          ],
          "description": "Registration action extension type"
        },
        "order": {
          "type": "number",
          "description": "Display order of the action extension"
        },
        "url": {
          "type": "string",
          "description": "URL path for the action extension"
        },
        "shortcutKey": {
          "type": "string",
          "description": "Keyboard shortcut key for the extension"
        },
        "buttonKind": {
          "type": "string",
          "enum": [
            "primary",
            "secondary",
            "tertiary",
            "ghost",
            "danger"
          ],
          "description": "Button kind/variant (defaults to 'primary' if not specified)"
        }
      }
    }
  },
  "properties": {
    "id": {
      "type": "string",
      "description": "Unique identifier for the registration configuration"
    },
    "contextModel": {
      "type": "array",
      "description": "Array of context model configurations",
      "items": {
        "type": "string"
      }
    },
    "defaultVisitType": {
      "type": "string",
      "description": "Default visit type for patient registration"
    },
    "registrationEncounterType": {
      "type": "string",
      "description": "Name of the encounter type to create automatically on patient registration"
    },
    "patientInformation": {
      "type": "object",
      "description": "Patient name related fields configuration",
      "additionalProperties": true,
      "properties": {
        "defaultIdentifierPrefix": {
          "type": "string",
          "description": "Default prefix for patient identifiers"
        },
        "showEnterManually": {
          "type": "boolean"
        },
        "showMiddleName": {
          "type": "boolean"
        },
        "showLastName": {
          "type": "boolean"
        },
        "isFirstNameMandatory": {
          "type": "boolean"
        },
        "isMiddleNameMandatory": {
          "type": "boolean"
        },
        "isGenderMandatory": {
          "type": "boolean"
        },
        "isDateOfBirthMandatory": {
          "type": "boolean"
        },
        "isLastNameMandatory": {
          "type": "boolean"
        },
        "patientNameDisplayOrder": {
          "type": "array",
          "description": "Order in which patient name fields should be displayed",
          "items": {
            "type": "string"
          }
        },
        "showBirthTime": {
          "type": "boolean"
        },
        "showDOBEstimated": {
          "type": "boolean"
        },
        "addressHierarchy": {
          "type": "object",
          "description": "Address hierarchy levels to be displayed",
          "additionalProperties": false,
          "properties": {
            "showAddressFieldsTopDown": {
              "type": "boolean"
            },
            "strictAutocompleteFromLevel": {
              "type": "string"
            },
            "expectedFields": {
              "type": "array",
              "description": "Array of expected fields with translation keys",
              "items": {
                "type": "object",
                "properties": {
                  "addressField": {
                    "type": "string",
                    "description": "Field name"
                  },
                  "translationKey": {
                    "type": "string",
                    "description": "Translation key for the field label"
                  }
                }
              }
            }
          }
        },
        "patientPhoto": {
          "type": "object",
          "description": "Patient photo capture constraints. Two mutually exclusive modes: (A) fixed dimensions with quality compression \u2014 provide widthPx + heightPx; (B) variable dimensions at full quality \u2014 provide all four of minWidthPx, maxWidthPx, minHeightPx, maxHeightPx. maxFileSizeKb is optional in both modes (defaults to 500). Partial Mode B configs are rejected at validation time.",
          "additionalProperties": false,
          "properties": {
            "widthPx": {
              "type": "number",
              "description": "Mode A: target photo width in pixels"
            },
            "heightPx": {
              "type": "number",
              "description": "Mode A: target photo height in pixels"
            },
            "minWidthPx": {
              "type": "number",
              "description": "Mode B: minimum photo width in pixels"
            },
            "maxWidthPx": {
              "type": "number",
              "description": "Mode B: maximum photo width in pixels"
            },
            "minHeightPx": {
              "type": "number",
              "description": "Mode B: minimum photo height in pixels"
            },
            "maxHeightPx": {
              "type": "number",
              "description": "Mode B: maximum photo height in pixels"
            },
            "maxFileSizeKb": {
              "type": "number",
              "description": "Maximum photo file size in kilobytes"
            }
          },
          "dependencies": {
            "minWidthPx": [
              "maxWidthPx",
              "minHeightPx",
              "maxHeightPx"
            ],
            "maxWidthPx": [
              "minWidthPx",
              "minHeightPx",
              "maxHeightPx"
            ],
            "minHeightPx": [
              "minWidthPx",
              "maxWidthPx",
              "maxHeightPx"
            ],
            "maxHeightPx": [
              "minWidthPx",
              "maxWidthPx",
              "minHeightPx"
            ]
          }
        },
        "additionalPatientInformation": {
          "type": "object",
          "description": "Additional patient information configuration",
          "additionalProperties": true,
          "properties": {
            "translationKey": {
              "type": "string",
              "description": "Translation key for the section title"
            },
            "attributes": {
              "type": "array",
              "description": "Array of attribute fields with translation keys",
              "items": {
                "type": "object",
                "required": [
                  "field",
                  "translationKey"
                ],
                "properties": {
                  "field": {
                    "type": "string",
                    "description": "Field name"
                  },
                  "translationKey": {
                    "type": "string",
                    "description": "Translation key for the field label"
                  }
                }
              }
            }
          }
        },
        "contactInformation": {
          "type": "object",
          "additionalProperties": true,
          "properties": {
            "translationKey": {
              "type": "string",
              "description": "Translation key for the section title"
            },
            "attributes": {
              "type": "array",
              "description": "Array of attribute fields with translation keys",
              "items": {
                "type": "object",
                "required": [
                  "field",
                  "translationKey"
                ],
                "properties": {
                  "field": {
                    "type": "string",
                    "description": "Field name"
                  },
                  "translationKey": {
                    "type": "string",
                    "description": "Translation key for the field label"
                  }
                }
              }
            }
          }
        }
      }
    },
    "fieldValidation": {
      "type": "object",
      "description": "Field validation rules with regex patterns and error messages",
      "additionalProperties": true,
      "patternProperties": {
        "^.*$": {
          "type": "object",
          "properties": {
            "pattern": {
              "type": "string",
              "description": "Regular expression pattern for field validation"
            },
            "errorMessage": {
              "type": "string",
              "description": "Error message to display when validation fails"
            }
          }
        }
      }
    },
    "registrationForm": {
      "type": "object",
      "description": "Configuration for registration form sections and controls",
      "additionalProperties": false,
      "properties": {
        "sections": {
          "type": "array",
          "description": "Array of form sections to display",
          "uniqueItems": true,
          "items": {
            "type": "object",
            "required": [
              "name",
              "controls"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "description": "Display name of the section"
              },
              "translationKey": {
                "type": "string",
                "description": "Translation key for the section title"
              },
              "collapsible": {
                "type": "boolean",
                "description": "Whether the section can be collapsed by the user. Defaults to true (collapsible). Set to false to always show the section expanded without a toggle button."
              },
              "controls": {
                "type": "array",
                "description": "Array of form controls in this section",
                "items": {
                  "type": "object",
                  "required": [
                    "type"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "type": {
                      "type": "string",
                      "enum": [
                        "address",
                        "contactInfo",
                        "additionalInfo",
                        "additionalIdentifiers",
                        "relationships"
                      ],
                      "description": "Type of form control to render"
                    },
                    "titleTranslationKey": {
                      "type": "string",
                      "description": "Optional translation key for the control's sub-heading. If absent, no heading is rendered."
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "extensions": {
      "type": "array",
      "description": "List of app-specific extension configurations (search widgets and action buttons). Distinguished by extensionPointId; action extensions carry extensionParams.type (link | startVisit).",
      "items": {
        "type": "object",
        "required": [
          "id",
          "extensionPointId"
        ],
        "additionalProperties": true,
        "properties": {
          "id": {
            "type": "string"
          },
          "extensionPointId": {
            "type": "string"
          },
          "translationKey": {
            "type": "string"
          },
          "icon": {
            "type": "string"
          },
          "requiredPrivileges": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "extensionParams": {
            "oneOf": [
              { "$ref": "#/definitions/searchExtensionParams" },
              { "$ref": "#/definitions/actionExtensionParams" }
            ]
          }
        },
        "if": {
          "properties": {
            "extensionParams": {
              "properties": {
                "type": {
                  "const": "startVisit"
                }
              },
              "required": [
                "type"
              ]
            }
          },
          "required": [
            "extensionParams"
          ]
        },
        "then": {},
        "else": {
          "required": [
            "translationKey"
          ]
        }
      }
    },
    "printOptions": {
      "type": "array",
      "description": "Print options shown in the print button on the registration page",
      "items": {
        "type": "object",
        "required": ["translationKey", "templateId"],
        "additionalProperties": false,
        "properties": {
          "translationKey": { "type": "string" },
          "templateId": { "type": "string" },
          "privileges": {
            "type": "array",
            "items": { "type": "string" }
          }
        }
      }
    }
  }
}
