{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Clinical App Configuration Schema",
  "description": "Schema for global clinical app configuration including patient information, actions and available dashboards",
  "type": "object",
  "required": [
    "patientInformation",
    "actions",
    "dashboards",
    "consultationPad"
  ],
  "additionalProperties": false,
  "definitions": {
    "inputControl": {
      "type": "object",
      "required": [
        "type",
        "metadata",
        "encounterTypes",
        "privileges",
        "attributes"
      ],
      "additionalProperties": true,
      "properties": {
        "type": {
          "type": "string",
          "description": "Identifier matching the registered form key (e.g. encounterDetails, allergies)"
        },
        "label": {
          "type": "string",
          "description": "Display label for the input control"
        },
        "metadata": {
          "type": "object",
          "description": "Additional metadata for the input control"
        },
        "encounterTypes": {
          "type": "array",
          "description": "Encounter types for which this control is shown",
          "items": {
            "type": "string"
          }
        },
        "privileges": {
          "type": "array",
          "description": "Privileges required to view this control",
          "items": {
            "type": "string"
          }
        },
        "attributes": {
          "type": "array",
          "description": "Form attributes configuration",
          "items": {
            "type": "object",
            "required": ["name"],
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "description": "Attribute name"
              },
              "required": {
                "type": "boolean",
                "description": "Whether this attribute is required"
              },
              "default": {
                "type": ["string", "number", "boolean"],
                "description": "Default value to pre-populate the field with"
              },
              "readOnly": {
                "type": "boolean",
                "description": "Whether this field is non-editable by the user"
              }
            }
          }
        },
        "cdss": {
          "type": "array",
          "description": "CDSS rules configuration for this input control",
          "items": {
            "type": "object",
            "required": ["event", "server", "service"],
            "additionalProperties": false,
            "properties": {
              "event": {
                "type": "string",
                "description": "Event name that triggers CDSS check (e.g., onSelect, onSave)"
              },
              "server": {
                "type": "string",
                "description": "CDSS server identifier"
              },
              "service": {
                "type": "string",
                "description": "CDSS service endpoint name"
              }
            }
          }
        }
      }
    }
  },
  "properties": {
    "patientInformation": {
      "type": "object",
      "description": "Patient information configuration",
      "additionalProperties": false
    },
    "contextInformation": {
      "type": "object",
      "description": "Context information configuration for displaying additional patient context",
      "additionalProperties": false,
      "properties": {
        "program": {
          "type": "object",
          "description": "Program details configuration",
          "required": ["fields"],
          "additionalProperties": false,
          "properties": {
            "fields": {
              "type": "array",
              "description": "List of fields to display in program details",
              "items": {
                "type": "object",
                "required": ["name"],
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "Field name to display"
                  },
                  "enableTranslation": {
                    "type": "boolean",
                    "description": "Whether to translate the value of this field"
                  }
                }
              }
            },
            "overlayStates": {
              "type": "array",
              "description": "Program workflow state names that should show a blocking loading overlay while the transition to that state is in progress",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "patientSearch": {
      "type": "object",
      "description": "Configuration for patient search dropdown display",
      "additionalProperties": false,
      "properties": {
        "displayFields": {
          "type": "array",
          "description": "Fields to display in patient search dropdown results. Each entry maps to a PatientSearchResult field.",
          "items": {
            "type": "object",
            "required": ["field"],
            "additionalProperties": false,
            "properties": {
              "field": {
                "type": "string",
                "enum": ["name", "identifier", "gender", "age"],
                "description": "Field name from PatientSearchResult"
              },
              "bold": {
                "type": "boolean",
                "description": "Whether to render this field in bold"
              }
            }
          }
        }
      }
    },
    "actions": {
      "type": "array",
      "description": "List of available actions"
    },
    "dashboards": {
      "type": "array",
      "description": "List of available dashboards",
      "items": {
        "type": "object",
        "required": ["name", "requiredPrivileges", "url"],
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "description": "Display name of the dashboard"
          },
          "requiredPrivileges": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "List of permissions required to access this dashboard"
          },
          "icon": {
            "type": "string",
            "description": "Icon class name for the dashboard"
          },
          "default": {
            "type": "boolean",
            "description": "Whether this is the default dashboard"
          },
          "url": {
            "type": "string",
            "description": "URL to access the dashboard data"
          },
          "printOptions": {
            "type": "array",
            "description": "Print options shown in the print button for this dashboard",
            "items": {
              "type": "object",
              "required": ["translationKey", "templateId"],
              "additionalProperties": false,
              "properties": {
                "translationKey": { "type": "string" },
                "templateId": { "type": "string" },
                "privileges": {
                  "type": "array",
                  "items": { "type": "string" }
                }
              }
            }
          }
        }
      }
    },
    "extensions": {
      "type": "array",
      "description": "List of app-specific extension configurations",
      "items": {
        "type": "object",
        "required": ["id", "extensionPointId", "translationKey"],
        "additionalProperties": true,
        "properties": {
          "id": { "type": "string" },
          "extensionPointId": { "type": "string" },
          "translationKey": { "type": "string" },
          "icon": { "type": "string" },
          "requiredPrivileges": {
            "type": "array",
            "items": { "type": "string" }
          },
          "extensionParams": {
            "type": "object",
            "additionalProperties": true,
            "properties": {
              "searchHandler": { "type": "string" },
              "configUrl": { "type": "string" }
            }
          }
        }
      }
    },
    "consultationPad": {
      "type": "object",
      "description": "Configuration for consultation pad forms",
      "required": ["allergyConceptMap", "inputControls"],
      "additionalProperties": true,
      "properties": {
        "allergyConceptMap": {
          "type": "object",
          "description": "UUID mappings for allergy concepts",
          "required": [
            "medicationAllergenUuid",
            "foodAllergenUuid",
            "environmentalAllergenUuid",
            "allergyReactionUuid"
          ],
          "additionalProperties": false,
          "properties": {
            "medicationAllergenUuid": {
              "type": "string",
              "description": "UUID for medication allergen concept"
            },
            "foodAllergenUuid": {
              "type": "string",
              "description": "UUID for food allergen concept"
            },
            "environmentalAllergenUuid": {
              "type": "string",
              "description": "UUID for environmental allergen concept"
            },
            "allergyReactionUuid": {
              "type": "string",
              "description": "UUID for allergy reaction concept"
            }
          }
        },
        "statDurationInMilliseconds": {
          "type": "number",
          "description": "Duration in milliseconds for which a STAT order is valid"
        },
        "inputControls": {
          "type": "array",
          "description": "Ordered list of input controls to display in the consultation pad",
          "items": {
            "$ref": "#/definitions/inputControl"
          }
        }
      }
    }
  }
}
