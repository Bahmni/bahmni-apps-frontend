{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Reports App Configuration",
  "type": "object",
  "properties": {
    "config": {
      "type": "object",
      "properties": {
        "supportedFormats": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "List of supported report formats"
        },
        "paperSize": {
          "type": "string",
          "description": "Default paper size for generated reports (e.g., A4)"
        },
        "enableReportQueue": {
          "type": "boolean",
          "description": "Whether reports can be queued (run asynchronously) in addition to running immediately"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
